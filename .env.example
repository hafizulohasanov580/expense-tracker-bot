# --- Supabase (get these from your project: Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is only used server-side by the edge function and is
# injected automatically by Supabase in production — you only need it here
# for local `supabase functions serve`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram bot (get from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:AA...
# Any random string; used to verify that webhook requests really come from Telegram.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
